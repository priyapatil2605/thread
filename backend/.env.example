PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/thread
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Virtual try-on works FREE out of the box, no key needed — it uses the
# public Hugging Face Space for IDM-VTON. It's a shared community demo
# though (queues, occasional downtime), not a dedicated API.
#
# Optional: set REPLICATE_API_TOKEN below to switch to Replicate's paid,
# more reliable version instead (a few cents per try-on). Get a key at
# https://replicate.com/account/api-tokens. Leave it blank to keep using
# the free path.
REPLICATE_API_TOKEN=

# Optional — a free Hugging Face token (huggingface.co/settings/tokens)
# raises the free path's rate limits slightly. Not required.
HF_TOKEN=
